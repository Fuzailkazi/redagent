# ArmorIQ red-teaming — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit a real .env or real secrets.

# --- Postgres (packages/db, Prisma) ---
# Native dev machine (trust auth for your OS user):
#   DATABASE_URL=postgresql://<osuser>@localhost:5432/redagent
# Docker (docker-compose.yml, trust auth, user "postgres"):
#   DATABASE_URL=postgresql://postgres@localhost:5432/redagent
DATABASE_URL=postgresql://postgres@localhost:5432/redagent

# --- Redis (apps/worker BullMQ, apps/api producer) ---
REDIS_URL=redis://localhost:6379

# --- Tier-2 LLM judge (optional) ---
# If OPENAI_API_KEY is unset, scans that would use the judge run Tier-1 only and
# record judgeModel=null — they do NOT fail.
OPENAI_API_KEY=
# Model used by the judge when a key is present. Defaults to gpt-4o.
JUDGE_MODEL=gpt-4o
