{
  "name": "@armoriq/redteam-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ArmorIQ agent red-teaming POC — zero-runtime-dependency CLI (Node >=18).",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "redteam": "./src/redteam.ts"
  },
  "scripts": {
    "dev": "tsx src/redteam.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
